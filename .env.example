# Salin jadi .env lalu isi — JANGAN commit .env!
BOT_TOKEN=tempel-token-dari-botfather

# [sangat disarankan] batasi bot hanya untuk id Telegram-mu (pisah koma).
# Cari id-mu dengan @userinfobot. Kosong = siapa pun bisa pakai.
# ALLOWED_USER_IDS=123456789

# Tolak start kalau ALLOWED_USER_IDS kosong (1 = wajib allowlist)
# REQUIRE_ALLOWLIST=1

# Siapa yang boleh /status (kosong = semua pemakai bot)
# ADMIN_IDS=123456789

# Chat admin untuk notifikasi job gagal (kosong = ADMIN_IDS pertama)
# ADMIN_CHAT_ID=123456789

# Opsional (sudah ada default yang sehat dalam kode):
# STORE_DB=store.db                # database SQLite (di Docker: /app/data/store.db)
# STORE_FILE=store.json            # JSON lama, dimigrasikan sekali lalu *.migrated
# TMP_DIR=temp                     # di Docker di-set /app/data/temp
# BACKUP_DIR=backups               # cadangan SQLite (di Docker: /app/data/backups)
# BACKUP_KEEP=7                    # jumlah cadangan harian yang dipertahankan
# BACKUP_AUTO=on                   # cadangan SQLite otomatis 23:30 WIB
# LOG_JSON=0                       # 1 = log JSON satu baris (untuk jq di VPS)
# SAHAMBOT_LOCAL_MODEL=models/indo-fin-roberta
# SAHAMBOT_CACHE=temp/cache        # cache harga utk fallback Yahoo 429
# SAHAMBOT_TTL=300                 # umur cache harga di memori (detik, 0 = mati)
# SAHAMBOT_FUND_TTL=21600          # umur cache fundamental di memori (detik)
# SAHAMBOT_NEWS_TTL=900            # umur cache berita di memori (detik)
# BANDAR_TTL=600                   # umur cache ringkasan broker/bandar (detik)
# YF_RETRIES=3                     # percobaan ulang ambil data Yahoo
# SARAN_CONCURRENCY=4              # jumlah request paralel untuk /saran
# HEARTBEAT_FILE=heartbeat.txt     # dipakai HEALTHCHECK Docker (kosong = mati)
# DOWNLOAD_CHUNK=4

# Screener & scorecard:
# FULL_SCAN_AUTO=on                # scan seluruh pasar harian 16:15 WIB
# FULL_SCAN_PERIOD=1y              # rentang histori unduhan screener
# FULL_SCAN_CHUNK=80               # ukuran batch yf.download
# FULL_SCAN_PAUSE=1.0              # jeda antar-batch (detik)
# FULL_SCAN_MAX_STALE_DAYS=5       # tolak emiten dengan bar basi > N hari bursa
# SCORECARD_HORIZON=20             # horizon evaluasi histori sinyal (hari bursa)

# Rencana & anggaran (/paket):
# PLAN_MIN_VALUE=2000000000        # likuiditas minimum Rp2 miliar/hari
# PLAN_MIN_PRICE=50                # filter harga minimum rencana (bukan floor BEI)
# PLAN_MAX_POS_PCT=0.20            # batas ukuran posisi default (20%)
# PLAN_MAX_PLANS=3                 # jumlah kandidat maksimum per /paket
# PLAN_POOL=16                     # pool kandidat yang diperkaya

# Libur bursa tambahan & jendela regulasi BEI:
# MARKET_HOLIDAYS=2026-03-19,2026-03-20
# MARKET_HOLIDAYS_FILE=market_holidays.json
# IDX_ARA_WINDOW_END=2026-12-31    # perpanjang tanggal akhir jendela ARA bila diperpanjang BEI
# IDX_ARB_WINDOW_END=2026-12-31    # perpanjang tanggal akhir ARB asimetris 7% (Kep-00158)

# Opsional P25 — fallback data OHLCV harian (.JK) saat Yahoo gagal/429 (default nonaktif):
# EODHD_API_KEY=
# ALPHAVANTAGE_API_KEY=
